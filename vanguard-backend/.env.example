# Required environment variables — set these in Vercel Dashboard
# Settings → Environment Variables

ZOHO_USER=contact@vanguardtechops.com
ZOHO_PASS=your_zoho_app_password_here
MAIL_TO=contact@vanguardtechops.com

# Cloudflare Turnstile secret key (Cloudflare Dashboard → Turnstile → your widget).
# For local testing, 1x0000000000000000000000000000000AA always passes.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
